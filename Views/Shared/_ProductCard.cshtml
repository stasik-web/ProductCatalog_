@model ProductCatalog.Models.Product

<div class="card h-100 shadow-sm">
    <div class="card-header bg-primary text-white">
        <h5 class="mb-0">@Model.Name</h5>
    </div>
    <div class="card-body">
        <p class="mb-1"><strong>ID:</strong> @Model.Id</p>
        <p class="mb-1"><strong>Санат:</strong> @Model.Category</p>
        <p class="mb-2"><strong>Баға:</strong> @Model.Price.ToString("N0") ₸</p>

        @if (Model.IsAvailable)
        {
            <span class="badge bg-success">Қолда бар</span>
        }
        else
        {
            <span class="badge bg-secondary">Қолда жоқ</span>
        }
    </div>
</div>
